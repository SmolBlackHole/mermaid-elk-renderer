{
  "name": "mermaid-elk-renderer",
  "version": "1.2.1",
  "description": "Re-enables ELK layout support for Mermaid diagrams in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "render-svgs": "node scripts/render-svgs.mjs"
  },
  "keywords": [],
  "author": "SmolBlackHole",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.2",
    "mermaid": "^11.16.0",
    "mermaid-layout-elk-obsidian": "npm:@mermaid-js/layout-elk@^0.2.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fast-check": "^4.9.0",
    "obsidian": "1.13.1",
    "tslib": "^2.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
